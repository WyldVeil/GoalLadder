{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GoalLadder",
  "mainBinaryName": "goalladder",
  "version": "1.1.0",
  "identifier": "com.wyldveil.goalladder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Goal Ladder",
        "width": 1120,
        "height": 800,
        "minWidth": 480,
        "minHeight": 480,
        "center": true,
        "backgroundColor": "#242933"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "WyldVeil",
    "category": "Productivity",
    "shortDescription": "Goals that unlock one after another",
    "longDescription": "A simple goal tracker. Write down a goal and, if it leads somewhere, what comes after it. Only the next step is in focus; later steps stay locked until you reach the one before. Everything is stored locally.",
    "linux": {
      "deb": {
        "desktopTemplate": "../packaging/goalladder.desktop"
      },
      "rpm": {
        "desktopTemplate": "../packaging/goalladder.desktop"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
